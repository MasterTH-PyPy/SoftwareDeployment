@page "/settings"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject SettingsService SettingsSvc
@inject IDirectoryService Ad
@inject IJSRuntime JS

<h1>Einstellungen</h1>

<div class="card">
    <h2>Allgemein</h2>
    <div class="field-row">
        <div class="field">
            <label>Poll-Intervall (Sekunden)</label>
            <input type="number" min="30" max="86400" @bind="_pollInterval" />
            <span class="muted">Wie oft Clients beim Server nachfragen. Standard: 300 (5 min).</span>
        </div>
        <div class="field">
            <label>Organisation</label>
            <input type="text" @bind="_orgName" />
        </div>
    </div>
    <div class="field">
        <div class="checkbox">
            <input type="checkbox" id="autoapprove" @bind="_autoApprove" />
            <label for="autoapprove" style="margin:0;">Neue Clients automatisch freigeben (nicht empfohlen)</label>
        </div>
    </div>
    @if (_generalSaved)
    {
        <div class="alert alert-success">Gespeichert.</div>
    }
    <button class="btn btn-primary" @onclick="SaveGeneral">Speichern</button>
</div>

<div class="card">
    <h2>Darstellung (eigenes CSS)</h2>
    <p class="muted">
        Für die Anpassung an den Kunden. Dieses CSS wird nach dem Basis-Stylesheet geladen und
        überschreibt es – am einfachsten über die CSS-Variablen im <code>:root</code>.
        Änderungen greifen nach einem Neuladen der Seite.
    </p>
    <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:stretch;">
        <div style="flex:1; min-width:300px; display:flex; flex-direction:column;">
            <label>Eigenes CSS</label>
            <textarea rows="16" class="mono" style="flex:1; resize:vertical;"
                      @bind="_customCss" @bind:event="oninput" @bind:after="PushPreview"
                      placeholder=":root { --primary: #0a7d2c; --bg-sidebar: #14321f; }"></textarea>
        </div>
        <div style="flex:1; min-width:300px; display:flex; flex-direction:column;">
            <label>Live-Vorschau (ungespeichert)</label>
            <iframe id="cssPreviewFrame" title="CSS-Vorschau" srcdoc="@_previewSrcDoc"
                    style="flex:1; min-height:360px; width:100%; border:1px solid var(--border); border-radius:8px; background:#fff;"></iframe>
        </div>
    </div>
    <details style="margin-top:.5rem;">
        <summary class="muted" style="cursor:pointer;">Verfügbare CSS-Variablen</summary>
        <pre class="mono" style="white-space:pre-wrap; margin:.5rem 0;">--primary, --primary-hover, --bg-sidebar, --surface, --surface-muted,
--border, --text, --text-muted, --success, --warning, --danger, --radius</pre>
    </details>
    @if (_cssSaved)
    {
        <div class="alert alert-success">Gespeichert und für alle übernommen (nach Neuladen der Seite).</div>
    }
    <div class="actions" style="margin-top:.5rem;">
        <button class="btn" @onclick="InsertCssTemplate">Vorlage einfügen</button>
        <button class="btn btn-primary" @onclick="SaveCss">CSS speichern</button>
    </div>
</div>

<div class="card">
    <h2>Installations-Key (Enrollment)</h2>
    <p class="muted">
        Dieser Schlüssel muss bei der Client-Installation eingegeben werden. Ohne gültigen
        Schlüssel nimmt der Server keine Registrierung an. Er wird verschlüsselt gespeichert.
    </p>
    <div class="field">
        <div class="key-display">@_enrollmentKey</div>
    </div>
    @if (_keyRegenerated)
    {
        <div class="alert alert-warning">
            Neuer Schlüssel erzeugt. Bereits registrierte Clients sind nicht betroffen –
            neue Installationen benötigen jedoch diesen Schlüssel.
        </div>
    }
    <button class="btn" @onclick="RegenerateKey">Neuen Schlüssel erzeugen</button>
</div>

<div class="card">
    <h2>Administrator-Kennwort ändern</h2>
    <div class="field-row">
        <div class="field">
            <label>Aktuelles Kennwort</label>
            <input type="password" @bind="_oldPw" />
        </div>
        <div class="field">
            <label>Neues Kennwort</label>
            <input type="password" @bind="_newPw" />
        </div>
        <div class="field">
            <label>Bestätigen</label>
            <input type="password" @bind="_confirmPw" />
        </div>
    </div>
    @if (_pwMessage is not null)
    {
        <div class="alert @(_pwOk ? "alert-success" : "alert-danger")">@_pwMessage</div>
    }
    <button class="btn btn-primary" @onclick="ChangePassword">Kennwort ändern</button>
</div>

<div class="card">
    <h2>Verzeichnis (Active Directory)</h2>
    @{
        var dom = Ad.GetDomainInfo();
    }
    @if (dom.Connected)
    {
        <div class="alert alert-success">Verbunden: <span class="mono">@dom.Name</span>@(dom.DnsName is null ? "" : $" ({dom.DnsName})")</div>
    }
    else
    {
        <div class="alert alert-warning">
            Nicht verbunden. @dom.Error
        </div>
    }
</div>

@code {
    private int _pollInterval = 300;
    private bool _autoApprove;
    private string _orgName = "Software Deployment";
    private bool _generalSaved;

    private string _customCss = "";
    private bool _cssSaved;
    private string _previewSrcDoc = "";

    private string _enrollmentKey = "";
    private bool _keyRegenerated;

    private string _oldPw = "", _newPw = "", _confirmPw = "";
    private string? _pwMessage;
    private bool _pwOk;

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsSvc.GetAsync();
        _pollInterval = s.PollIntervalSeconds;
        _autoApprove = s.AutoApproveClients;
        _orgName = s.OrganizationName;
        _customCss = s.CustomCss ?? "";
        _previewSrcDoc = BuildPreviewDoc(_customCss);
        _enrollmentKey = await SettingsSvc.GetEnrollmentKeyAsync();
    }

    // Push the current (unsaved) CSS into the preview iframe live, without reload.
    private async Task PushPreview()
    {
        try { await JS.InvokeVoidAsync("setPreviewCss", _customCss); }
        catch { /* iframe not ready yet – initial CSS is already baked into srcdoc */ }
    }

    private async Task SaveGeneral()
    {
        await SettingsSvc.SaveGeneralAsync(_pollInterval, _autoApprove, _orgName);
        _generalSaved = true;
    }

    private async Task SaveCss()
    {
        await SettingsSvc.SaveCustomCssAsync(_customCss);
        _cssSaved = true;
    }

    private async Task InsertCssTemplate()
    {
        if (string.IsNullOrWhiteSpace(_customCss))
        {
            _customCss =
                ":root {\n" +
                "    --primary: #0a7d2c;        /* Akzent-/Buttonfarbe */\n" +
                "    --primary-hover: #086423;\n" +
                "    --bg-sidebar: #14321f;     /* Seitenleiste */\n" +
                "    --surface: #ffffff;        /* Karten/Flächen */\n" +
                "    --text: #0f172a;\n" +
                "    --radius: 10px;\n" +
                "}\n";
            await PushPreview();
        }
    }

    // A small, representative snapshot of the UI that loads the real app.css.
    // #userCss carries the initial (saved) CSS; live edits replace it via JS.
    private static string BuildPreviewDoc(string css) =>
        "<!DOCTYPE html><html lang=\"de\"><head><meta charset=\"utf-8\">" +
        "<link rel=\"stylesheet\" href=\"/css/app.css\">" +
        "<style id=\"userCss\">" + css + "</style>" +
        "<style>html,body{margin:0;height:100%;}</style></head><body>" +
        "<div class=\"app-shell\" style=\"min-height:340px;\">" +
          "<aside class=\"sidebar\" style=\"width:170px;\">" +
            "<div class=\"brand\"><div class=\"brand-text\">" +
              "<span class=\"brand-title\">Beispiel</span><span class=\"brand-sub\">Vorschau</span></div></div>" +
            "<nav class=\"nav\">" +
              "<a class=\"nav-item active\">Dashboard</a>" +
              "<a class=\"nav-item\">Pakete</a>" +
              "<a class=\"nav-item\">Einstellungen</a></nav></aside>" +
          "<div class=\"main\">" +
            "<header class=\"topbar\"><div class=\"topbar-spacer\"></div><a class=\"logout\">Abmelden</a></header>" +
            "<main class=\"content\">" +
              "<div class=\"card\"><h2>Beispielkarte</h2>" +
                "<div class=\"actions\" style=\"margin-bottom:.75rem;\">" +
                  "<button class=\"btn btn-primary\">Primär</button>" +
                  "<button class=\"btn btn-success\">Erfolg</button>" +
                  "<button class=\"btn btn-danger\">Löschen</button>" +
                  "<button class=\"btn btn-sm\">Klein</button></div>" +
                "<p><span class=\"badge badge-approved\">Freigegeben</span> " +
                  "<span class=\"badge badge-pending\">Offen</span> " +
                  "<span class=\"badge badge-failed\">Fehler</span></p>" +
                "<table><thead><tr><th>Name</th><th>Status</th></tr></thead><tbody>" +
                  "<tr><td>Client-01</td><td><span class=\"badge badge-approved\">Aktiv</span></td></tr>" +
                  "<tr><td>Client-02</td><td><span class=\"badge badge-muted\">—</span></td></tr></tbody></table>" +
                "<div class=\"field\" style=\"margin-top:.75rem;\"><label>Eingabe</label>" +
                  "<input type=\"text\" value=\"Beispiel\"></div>" +
              "</div></main></div></div></body></html>";

    private async Task RegenerateKey()
    {
        _enrollmentKey = await SettingsSvc.RegenerateEnrollmentKeyAsync();
        _keyRegenerated = true;
    }

    private async Task ChangePassword()
    {
        _pwMessage = null;
        if (!await SettingsSvc.VerifyAdminPasswordAsync(_oldPw))
        {
            _pwOk = false; _pwMessage = "Aktuelles Kennwort ist falsch.";
            return;
        }
        if (_newPw.Length < 10)
        {
            _pwOk = false; _pwMessage = "Das neue Kennwort muss mindestens 10 Zeichen haben.";
            return;
        }
        if (_newPw != _confirmPw)
        {
            _pwOk = false; _pwMessage = "Die neuen Kennwörter stimmen nicht überein.";
            return;
        }
        await SettingsSvc.SetAdminPasswordAsync(_newPw);
        _oldPw = _newPw = _confirmPw = "";
        _pwOk = true; _pwMessage = "Kennwort geändert.";
    }
}
