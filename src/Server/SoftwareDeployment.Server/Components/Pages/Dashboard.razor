@page "/"
@inject IDbContextFactory<DeploymentDbContext> DbFactory
@inject IDirectoryService Ad

<h1>Dashboard</h1>

@if (!Ad.IsAvailable)
{
    <div class="alert alert-warning">
        Kein Active Directory erreichbar. Zuweisungen und Poll-Auflösung funktionieren nur,
        wenn der Server domänengebunden unter dem Servicekonto läuft.
    </div>
}

<div class="grid cols-4">
    <div class="card stat">
        <div class="value">@_clientsTotal</div>
        <div class="label">Clients gesamt</div>
    </div>
    <div class="card stat">
        <div class="value" style="color:var(--warning)">@_clientsPending</div>
        <div class="label">Freigabe offen</div>
    </div>
    <div class="card stat">
        <div class="value">@_packages</div>
        <div class="label">Pakete</div>
    </div>
    <div class="card stat">
        <div class="value" style="color:var(--danger)">@_failures24h</div>
        <div class="label">Fehler (24 h)</div>
    </div>
</div>

<div class="card">
    <h2>Zuletzt gemeldet</h2>
    @if (_recent.Count == 0)
    {
        <div class="table-empty">Noch keine Installationsmeldungen.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Zeitpunkt</th><th>Client</th><th>Paket</th><th>Version</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var l in _recent)
                {
                    <tr>
                        <td class="mono">@l.ReportedAtUtc.LocalDateTime.ToString("dd.MM. HH:mm")</td>
                        <td>@l.Machine</td>
                        <td>@l.PackageName</td>
                        <td class="mono">@l.Version</td>
                        <td>@StatusBadge.Render(l.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private int _clientsTotal, _clientsPending, _packages, _failures24h;
    private List<Row> _recent = new();

    private sealed record Row(DateTimeOffset ReportedAtUtc, string Machine, string PackageName, string Version, InstallResultStatus Status);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _clientsTotal = await db.Clients.CountAsync();
        _clientsPending = await db.Clients.CountAsync(c => c.Status == ClientApprovalStatus.Pending);
        _packages = await db.Packages.CountAsync();

        DateTimeOffset since = DateTimeOffset.UtcNow.AddHours(-24);
        _failures24h = await db.InstallLogs
            .CountAsync(l => l.ReportedAtUtc >= since && l.Status == InstallResultStatus.Failed);

        var logs = await db.InstallLogs
            .OrderByDescending(l => l.ReportedAtUtc)
            .Take(15)
            .ToListAsync();

        var ids = logs.Select(l => l.ClientId).Distinct().ToList();
        var names = await db.Clients
            .Where(c => ids.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => c.MachineName);

        _recent = logs
            .Select(l => new Row(
                l.ReportedAtUtc,
                names.GetValueOrDefault(l.ClientId, "?"),
                l.PackageName, l.Version, l.Status))
            .ToList();
    }
}
