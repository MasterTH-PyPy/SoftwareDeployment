@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <img src="/img/logo.svg" alt="SonOG" class="brand-logo" />
            <div class="brand-text">
                <span class="brand-title">SonOG Deploy</span>
                <span class="brand-sub">Software Deployment</span>
            </div>
        </div>
        <NavMenu />
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="topbar-spacer"></div>
            <a class="logout" href="/account/logout">Abmelden</a>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>
