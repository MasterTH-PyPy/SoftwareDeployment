<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SoftwareDeployment.Server</RootNamespace>
    <AssemblyName>SoftwareDeployment.Server</AssemblyName>
    <Description>Deployment server: client REST API + Blazor admin web interface, hostable as a Windows Service.</Description>
    <UserSecretsId>sonog-softwaredeployment-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- DPAPI at-rest protection for the enrollment key (Windows; guarded fallback elsewhere). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Active Directory read access (Windows only; guarded at runtime). -->
    <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\SoftwareDeployment.Shared\SoftwareDeployment.Shared.csproj" />
  </ItemGroup>

  <!--
    NU1903 (GHSA-2m69-gcr7-jv3q): SQLitePCLRaw.lib.e_sqlite3 2.1.11 (transitiv über
    Microsoft.EntityFrameworkCore.Sqlite). Es gibt KEINE gepatchte NuGet-Version
    (Advisory: "Patched versions: None"); der Fix liegt in SQLite >= 3.50.2, das
    SQLitePCLRaw noch nicht ausliefert. Die Lücke betrifft das Verarbeiten
    manipulierter SQL/DB-Eingaben – hier öffnet der Server nur seine eigene DB und
    baut sein SQL selbst über EF, daher praktisch keine Angriffsfläche.
    Diese gezielte Unterdrückung wieder entfernen, sobald ein Bundle mit
    SQLite >= 3.50.2 verfügbar ist (dann auf die neue Version pinnen/aktualisieren).
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
